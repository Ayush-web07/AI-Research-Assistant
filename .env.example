# Copy this file to .env and fill in your free API key(s), OR set up Ollama below
# for a fully offline setup with no API key at all.
#
# By default (LLM_PROVIDER=auto) the app tries Groq -> Hugging Face -> Ollama,
# using whichever is configured/reachable first. You only need ONE provider.

# --- Option 1: Groq (recommended — fastest, generous free tier) ---
# Get a free key at https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=

# --- Option 2: Hugging Face Inference API ---
# Get a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=

# --- Option 3: Ollama (fully local/offline, no API key, no internet needed) ---
# 1. Install from https://ollama.com/download
# 2. Run: ollama pull llama3.1
# 3. Start it: `ollama serve` (or just open the Ollama app)
# Defaults below work out of the box — only change if you customized your Ollama setup.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Optional: force a specific provider instead of auto-detecting ---
# Values: auto (default) | groq | hf | ollama
LLM_PROVIDER=auto
